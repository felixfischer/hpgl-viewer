{
	"name": "hpgl-viewer",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"check": "pnpm typecheck && pnpm lint && pnpm test",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:e2e": "pnpm --filter @hpgl-viewer/web test:e2e",
		"build": "pnpm -r build",
		"dev": "pnpm --filter @hpgl-viewer/web dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
